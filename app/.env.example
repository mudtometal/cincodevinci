# ─── REQUIRED ────────────────────────────────────────────────
# Password for the /admin panel. Pick anything. Change it anytime.
ADMIN_PASSWORD=changeme

# Random string used to sign the admin login cookie.
# Generate one with:  openssl rand -hex 32
AUTH_SECRET=

# ─── DATABASE (required in production) ───────────────────────
# Any Postgres URL. Supabase, Neon and Vercel Postgres all work.
# Leave blank to run on a local file (development only).
DATABASE_URL=

# ─── PAYMENTS (optional — shop stays hidden until these exist)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── EMAIL (optional — signups still get saved without it) ───
RESEND_API_KEY=
MAIL_FROM="Cincodevinci <noreply@yourdomain.com>"

# ─── SMS (optional — signups still get saved without it) ─────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── SITE ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
